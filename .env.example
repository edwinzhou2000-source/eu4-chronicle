# 复制为 .env 后填写。切勿把真实 Key 提交进 Git。
#   cp .env.example .env

EU4_SAVE_DIR=

# 默认 mock：不调外部模型，本地即可出成稿
EU4_CHRONICLE_MODE=mock

# ---------- OpenAI（官方）----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EU4_CHRONICLE_MODE=llm

# ---------- Gemini（官方 OpenAI 兼容端点，同一套客户端）----------
# 文档：https://ai.google.dev/gemini-api/docs/openai
# OPENAI_API_KEY=你的_Gemini_API_Key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# EU4_CHRONICLE_MODE=llm

# 兼容旧名（可选）：EU4_CHRONICLE_MODEL 与 OPENAI_MODEL 等价，优先读 OPENAI_MODEL
