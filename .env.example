# 复制为 .env 后填写。切勿把真实 Key 提交进 Git。
#   cp .env.example .env

# 存档目录（可选）。留空 / 删掉该行时自动探测：
# - Windows：%USERPROFILE%\Documents\Paradox Interactive\Europa Universalis IV\save games
# - WSL：/mnt/c/Users/<你>/Documents/Paradox Interactive/Europa Universalis IV/save games
# WSL 下也可直接写 Windows 路径（会自动转成 /mnt/c/...），例如：
# EU4_SAVE_DIR=C:\Users\YourName\Documents\Paradox Interactive\Europa Universalis IV\save games
# 不要写成 EU4_SAVE_DIR=（空串会变成当前目录「.」）
# EU4_SAVE_DIR=/mnt/c/Users/YourName/Documents/Paradox Interactive/Europa Universalis IV/save games

# 游戏安装目录（可选；用于任务书 title/desc 本地化）。留空则自动探测 Steam 常见路径。
# EU4_GAME_DIR=D:\Games\Steam\steamapps\common\Europa Universalis IV
# EU4_GAME_DIR=/mnt/d/Games/Steam/steamapps/common/Europa Universalis IV

# Paradox 文档目录（可选；读 dlc_load.json 启用 Mod 本地化）。留空则自动探测。
# EU4_PARADOX_DOCS=C:\Users\YourName\Documents\Paradox Interactive\Europa Universalis IV

# 默认 mock：不调外部模型，本地即可出成稿
EU4_GAME_REPORT_MODE=mock

# ---------- OpenAI（官方）----------
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# EU4_GAME_REPORT_MODE=llm

# ---------- Gemini（官方 OpenAI 兼容端点，同一套客户端）----------
# 文档：https://ai.google.dev/gemini-api/docs/openai
# OPENAI_API_KEY=你的_Gemini_API_Key
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.0-flash
# EU4_GAME_REPORT_MODE=llm

# 可选：EU4_GAME_REPORT_MODEL 与 OPENAI_MODEL 等价，优先读 OPENAI_MODEL
